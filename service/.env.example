# Generate local values with python3 scripts/init_env.py; never commit .env.
FALCON_DB_PASSWORD=
FALCON_AUTH_TOKENS=
FALCON_RUNTIME_TOKEN=
FALCON_IMAGE_TAG=local-38c6da2
FALCON_WEB_PORT=8090
FALCON_ALLOWED_ORIGINS=["http://localhost:8090","http://127.0.0.1:8090"]
FALCON_COOKIE_SECURE=false
FALCON_LOCAL_AUTO_LOGIN=true
# Number of immutable gallery HNSW graphs cached by each API process.
FALCON_INDEX_CACHE_SIZE=2

# GPU runtime overlay (export these only when starting docker-compose.gpu.yml).
# FALCON_RUNTIME_IMAGE=registry.example/falcon-runtime@sha256:<64-hex-digest>
# FALCON_MODEL_BUNDLE_DIR=/absolute/path/to/falcon-model-bundle
# FALCON_EXPECTED_MODEL_ID=exact-model-id-from-runtime-bundle
# FALCON_EXPECTED_WEIGHTS_BYTES=derived-by-start_gpu.sh
# FALCON_MODEL_DEVICE=cuda
# FALCON_RUNTIME_MAX_CONCURRENCY=1
# FALCON_RUNTIME_SHM_SIZE=1gb
# FALCON_GPU_COUNT=1
